# THUGSred-smsGateway - secrets for the systemd service
# Install as /etc/thugsred/smsgateway.env with mode 0600 (root only).
# The unit file loads it through EnvironmentFile=; values are then available
# as "${NAME}" references in the configuration files.

# SMSGW_MYSQL_URL=mysql://smsgateway:change-me@db.example.invalid:3306/smsgateway
# SMS_WEBHOOK_SECRET=
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TEAMS_WORKFLOW_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
